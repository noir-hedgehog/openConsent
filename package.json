{
  "name": "openconsent",
  "version": "0.2.0-alpha.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Open compliance manifests, checks, evidence and transparency for AI-created and AI-powered software",
  "type": "module",
  "bin": {
    "openconsent": "./src/cli.mjs"
  },
  "scripts": {
    "check:example": "node ./src/cli.mjs check ./examples/openconsent.json",
    "test": "node --test",
    "test:sdk": "node --test ./test/runtime.test.mjs",
    "build:demo": "pnpm --dir apps/demo build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
