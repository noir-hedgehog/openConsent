{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/noir-hedgehog/openConsent/main/schema/openconsent.schema.json",
  "title": "openConsent project manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "jurisdictions",
    "applicability",
    "creation",
    "runtime",
    "activities",
    "personalData"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "owner",
        "privacyContact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "publicUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "privacyContact": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "email"
              ]
            },
            {
              "required": [
                "url"
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "jurisdictions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "gdpr",
          "ccpa"
        ]
      }
    },
    "applicability": {
      "type": "object",
      "properties": {
        "gdpr": {
          "$ref": "#/$defs/gdprApplicability"
        },
        "ccpa": {
          "$ref": "#/$defs/ccpaApplicability"
        }
      },
      "additionalProperties": false
    },
    "creation": {
      "type": "object",
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "enum": [
            "human",
            "ai-assisted",
            "agent-generated",
            "mixed",
            "unknown"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "usage"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "aiEnabled",
        "aiComponents"
      ],
      "properties": {
        "aiEnabled": {
          "type": "boolean"
        },
        "aiComponents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "purpose",
              "provider",
              "activityIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "model",
                  "agent",
                  "automated-decision",
                  "other"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "activityIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "aiEnabled": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "aiComponents": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "aiComponents": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "notices": {
      "type": "object",
      "required": [
        "privacy"
      ],
      "properties": {
        "privacy": {
          "$ref": "#/$defs/notice"
        },
        "collection": {
          "$ref": "#/$defs/notice"
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "properties": {
        "gdpr": {
          "$ref": "#/$defs/rightsChannel"
        },
        "ccpa": {
          "$ref": "#/$defs/rightsChannel"
        }
      },
      "additionalProperties": false
    },
    "gpc": {
      "type": "object",
      "required": [
        "honored"
      ],
      "properties": {
        "honored": {
          "type": "boolean"
        },
        "statusUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "activities": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "personalData": {
      "type": "object",
      "required": [
        "processed",
        "rationale",
        "decidedAt",
        "reviewer"
      ],
      "properties": {
        "processed": {
          "enum": [
            true,
            false,
            "needs-review"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "decidedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "notice": {
      "type": "object",
      "required": [
        "url",
        "version",
        "reviewedAt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rightsChannel": {
      "type": "object",
      "required": [
        "methods"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "webform",
                  "email",
                  "phone",
                  "mail",
                  "in-product"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "purpose",
        "dataCategories",
        "retention",
        "recipients",
        "sensitiveData",
        "automatedDecision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "dataCategories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "legalBasis": {
          "enum": [
            "consent",
            "contract",
            "legal-obligation",
            "vital-interests",
            "public-task",
            "legitimate-interests",
            "not-applicable",
            "needs-review"
          ]
        },
        "retention": {
          "type": "object",
          "required": [
            "period",
            "rationale"
          ],
          "properties": {
            "period": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consent": {
          "type": "object",
          "properties": {
            "withdrawal": {
              "type": "object",
              "required": [
                "method",
                "value"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "in-product",
                    "email",
                    "webform",
                    "api",
                    "other"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "legitimateInterestsAssessment": {
          "type": "string",
          "minLength": 1
        },
        "transfers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "destination",
              "outsideEea",
              "safeguard"
            ],
            "properties": {
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "outsideEea": {
                "type": "boolean"
              },
              "safeguard": {
                "enum": [
                  "adequacy",
                  "scc",
                  "bcr",
                  "derogation",
                  "none",
                  "needs-review"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "sensitiveData": {
          "type": "boolean"
        },
        "sensitiveUseOutsidePermittedPurposes": {
          "type": "boolean"
        },
        "limitUseUrl": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "knownMinorsUnder16": {
          "type": "boolean"
        },
        "minorOptInReviewed": {
          "type": "boolean"
        },
        "automatedDecision": {
          "type": "object",
          "required": [
            "significant"
          ],
          "properties": {
            "significant": {
              "type": "boolean"
            },
            "explanationUrl": {
              "type": "string",
              "format": "uri",
              "minLength": 1
            },
            "humanReview": {
              "type": "boolean"
            },
            "solelyAutomated": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "sale": {
          "type": "boolean"
        },
        "sharing": {
          "type": "boolean"
        },
        "optOut": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "link",
                "frictionless-signal"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "evidenceRef": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gdprApplicability": {
      "type": "object",
      "required": [
        "status",
        "rationale",
        "decidedAt",
        "role",
        "reviewer"
      ],
      "properties": {
        "status": {
          "enum": [
            "in-scope",
            "out-of-scope",
            "needs-review"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "controller",
            "processor",
            "joint-controller",
            "needs-review"
          ]
        },
        "decidedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ccpaApplicability": {
      "type": "object",
      "required": [
        "status",
        "rationale",
        "decidedAt",
        "role",
        "reviewer"
      ],
      "properties": {
        "status": {
          "enum": [
            "in-scope",
            "out-of-scope",
            "needs-review"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "business",
            "service-provider",
            "contractor",
            "needs-review"
          ]
        },
        "decidedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "personalData": {
            "properties": {
              "processed": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "notices",
          "rights"
        ],
        "properties": {
          "activities": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "personalData": {
            "properties": {
              "processed": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "activities": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
