{
  "name": "@openconsent/vue",
  "version": "0.3.0-beta.1",
  "description": "Vue plugin, composable and consent banner for openConsent",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": ["src"],
  "sideEffects": false,
  "dependencies": {
    "@openconsent/core": "workspace:*",
    "@openconsent/web": "workspace:*"
  },
  "peerDependencies": { "vue": ">=3.3" },
  "publishConfig": { "access": "public" },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/noir-hedgehog/openConsent.git", "directory": "packages/vue" }
}
